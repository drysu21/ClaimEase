# Copy to .env.local. Everything here is optional: with no key the built-in assistant answers.

# Use Gemini as the agent (get a key at https://aistudio.google.com/apikey).
# Leave empty to use the built-in rule-based assistant. GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Defaults shown. The model must support function calling.
# GEMINI_MODEL=gemini-3.5-flash-lite   # gemini-3.6-flash is smarter, but the free tier allows only 20 requests a day
# GEMINI_THINKING_LEVEL=low       # minimal | low | medium | high | default. "default" leaves it to the model,
#                                 # which was too slow here (each call timed out), so "low" is the default.
# GEMINI_TIMEOUT_MS=30000         # per model call; on timeout the built-in assistant answers instead

# Force the built-in assistant even when a key is set.
# CLAIMEASE_AGENT=rules


# Supabase (required). Project Settings -> API. Server only: never expose the secret key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
